{
  "manifest_version": 3,
  "name": "ChatGPT Agent Monitor",
  "version": "1.5.65",
  "description": "Keeps one long-running ChatGPT task moving with guarded continuation and handoff prompts.",
  "permissions": ["storage", "scripting", "alarms", "tabs", "power"],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://chat.openai.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "ChatGPT Agent Monitor",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
