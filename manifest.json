{
  "manifest_version": 3,
  "name": "Agent Monitor for ChatGPT and Gemini",
  "version": "1.6.5",
  "description": "Continues ChatGPT and Gemini tasks with guarded prompts, work tracking, and timed waits.",
  "permissions": ["storage", "scripting", "alarms", "tabs", "power"],
  "host_permissions": [
    "https://chatgpt.com/*",
    "https://chat.openai.com/*",
    "https://gemini.google.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Agent Monitor",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*",
        "https://gemini.google.com/*"
      ],
      "js": ["gemini.js", "content.js"],
      "run_at": "document_idle"
    }
  ]
}
